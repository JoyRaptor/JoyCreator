#!/usr/bin/env bash
# Same guard, for the commit message. Messages are the hardest part to clean up later:
# they cannot be fixed without rewriting history.
here="$(dirname "$0")"
command -v "${JOYGUARD_PERL:-perl}" > /dev/null 2>&1 || { echo "guard: perl not found - not checking." >&2; exit 0; }
exec "${JOYGUARD_PERL:-perl}" "$here/guard.pl" message "$1"
