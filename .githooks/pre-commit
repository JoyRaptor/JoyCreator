#!/usr/bin/env bash
# Blocks the owner's private words (real name, personal email, phone serials) from entering
# the repository: staged file contents and file names. The work is done by guard.pl, which
# reads the private list on the owner's PC or, elsewhere, the salted hashes in guard-hashes.
# See tasks/GIT_PRACTICE.md section 1.
#
# If this fires: use "JoyRaptor", studio@joycreator.cc, and "the sandbox phone".
# Do NOT bypass with --no-verify. Say so in your report if you think it is a false alarm.
here="$(dirname "$0")"
command -v "${JOYGUARD_PERL:-perl}" > /dev/null 2>&1 || { echo "guard: perl not found - not checking." >&2; exit 0; }
exec "${JOYGUARD_PERL:-perl}" "$here/guard.pl" staged
