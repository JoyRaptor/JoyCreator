<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY (merged into debug variants, never into a release). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Agents start an export over adb without tapping through the editor:
             adb shell am start -n com.fadcam.beta/com.fadcam.ui.faditor.export.ExportDebugActivity
                 -e project_id <uuid> [-\-el range_start_ms N -\-el range_end_ms M] [-\-ez audio_only true]
             showWhenLocked: it can run on a phone left locked on the charger overnight. -->
        <activity
            android:name="com.fadcam.ui.faditor.export.ExportDebugActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Joybot benchmark, live runs with the app's own saved key (tools/jvm-harness/joybot-bench, -\-phone) -->
        <activity
            android:name="com.fadcam.ui.faditor.ai.joybot.JoybotBenchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Black.NoTitleBar" />
        <!-- Joy Brush stroke replay benchmark (LEAD_PLAN_20261010 step 3); results: adb logcat -s JoyBrushPerf -->
        <activity
            android:name="com.fadcam.joybrush.JoyBrushBenchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
