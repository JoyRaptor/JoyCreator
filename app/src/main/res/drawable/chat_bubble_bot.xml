<?xml version="1.0" encoding="utf-8"?>
<!-- Bot bubble: rounded rect + a right-triangle tail in the top-left
     reserved band. The tail's outer edge (left, flush with the bubble's own
     left edge / toward the screen edge) is a straight vertical drop; only
     the inner edge (the hypotenuse, facing right/inward) angles in to the
     point — NOT a symmetric diamond notch. Reads as if the message is
     descending straight down from the AI assistant header above. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="10dp"
        android:height="7dp"
        android:gravity="top|left"
        android:left="14dp"
        android:top="0dp">
        <vector
            android:width="10dp"
            android:height="7dp"
            android:viewportWidth="10"
            android:viewportHeight="7">
            <!-- (0,0) outer point at top; (0,7) outer-bottom straight down
                 from (0,0); (10,7) inner-bottom, attaches under the bubble;
                 close back to (0,0) draws the angled inner hypotenuse. -->
            <path
                android:fillColor="#FF262626"
                android:pathData="M0,0 L0,7 L10,7 Z" />
        </vector>
    </item>
    <item android:top="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF262626" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
