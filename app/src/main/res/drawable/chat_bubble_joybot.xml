<?xml version="1.0" encoding="utf-8"?>
<!-- Joybot's answer bubble (owner, 10-28: the answer carries the colour, your own words fade
     back). Fill is the Studio's aqua-to-lime; text on it is s_on_go.
     The tail is at the BOTTOM LEFT and points down (owner, 11-14): Joybot lives in the lower left
     of the chat, so his words come from him, the way yours drop to the send button on the right.
     Mirror of chat_bubble_user: the outer (left) edge is a straight vertical drop and only the
     inner edge angles in. chat_bubble_bot (grey, for cards) keeps its own shape. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="10dp"
        android:height="7dp"
        android:gravity="bottom|left"
        android:left="24dp"
        android:bottom="0dp">
        <vector
            android:width="10dp"
            android:height="7dp"
            android:viewportWidth="10"
            android:viewportHeight="7">
            <!-- (0,0) outer-top; (10,0) inner-top, both under the bubble; (0,7) the point,
                 straight down from (0,0). -->
            <path
                android:fillColor="@color/s_go"
                android:pathData="M0,0 L10,0 L0,7 Z" />
        </vector>
    </item>
    <item android:bottom="7dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0"
                android:startColor="@color/s_go" android:endColor="@color/s_go_end" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
