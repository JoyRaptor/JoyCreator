<?xml version="1.0" encoding="utf-8"?>
<!-- User bubble: rounded rect + a right-triangle tail in the bottom-right
     reserved band. The tail's outer edge (right, flush with the bubble's
     own right edge / toward the screen edge) is a straight vertical drop;
     only the inner edge (the hypotenuse, facing left/inward) angles in to
     the point — NOT a symmetric diamond notch. Reads as if the message is
     rising straight up from the "Ask anything" box below. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="10dp"
        android:height="7dp"
        android:gravity="bottom|right"
        android:right="14dp"
        android:bottom="0dp">
        <vector
            android:width="10dp"
            android:height="7dp"
            android:viewportWidth="10"
            android:viewportHeight="7">
            <!-- (0,0) inner-top, attaches under the bubble; (10,0) outer-top;
                 (10,7) outer point straight down from (10,0); close back to
                 (0,0) draws the angled inner hypotenuse. -->
            <path
                android:fillColor="#FF1B3A20"
                android:pathData="M0,0 L10,0 L10,7 Z" />
        </vector>
    </item>
    <item android:bottom="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF1B3A20" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
