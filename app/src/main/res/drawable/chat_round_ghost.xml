<?xml version="1.0" encoding="utf-8"?>
<!-- The chat's round buttons: a faint white disc (design: rgba(255,255,255,.07)), brighter when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#33FFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#12FFFFFF" /></shape>
    </item>
</selector>
