<?xml version="1.0" encoding="utf-8"?>
<!-- The top of the conversation: carries on chat_header_fade's shade and fades to nothing, so the messages
     scroll up into a soft darkening, never a hard line (owner, 11-15 midday). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#590C0C10"
        android:centerColor="#1A0C0C10"
        android:endColor="#000C0C10" />
</shape>
