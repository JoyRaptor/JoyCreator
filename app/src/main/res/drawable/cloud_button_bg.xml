<?xml version="1.0" encoding="utf-8"?>
<!-- The Cloud button face: a raised zinc chip with a quiet press. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/s_pressed">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="@color/s_on_room"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="@color/s_raised"/>
        </shape>
    </item>
</ripple>
