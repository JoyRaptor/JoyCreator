<?xml version="1.0" encoding="utf-8"?>
<!--
    The "N more" pill at the end of the tool row. Raised surface, not an accent: it
    reports a fact about the row, it is not the thing you came to press.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="999dp" />
    <solid android:color="@color/s_raised" />
    <stroke android:width="1dp" android:color="@color/s_line" />
</shape>
