<?xml version="1.0" encoding="utf-8"?>
<!-- Recorder home: the small stripe in the corner of the elapsed-time card (the "flag", which a
     setting can hide). Was a purple wash; now a zinc fade, because colour on this screen is spent
     only on what to press and on what is ON. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="3dp" />
    <gradient
        android:angle="0"
        android:startColor="#00000000"
        android:endColor="@color/s_line"
        android:type="linear" />
    <size
        android:width="48dp"
        android:height="6dp" />
</shape>
