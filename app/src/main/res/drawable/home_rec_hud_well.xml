<?xml version="1.0" encoding="utf-8"?>
<!-- Recorder home: the zoom map's frame inside the zoom readout. A hairline well, so the white
     viewport square has a border to sit in without a second filled box. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/s_scrim_20" />
    <corners android:radius="6dp" />
    <stroke
        android:width="1dp"
        android:color="@color/s_line" />
</shape>
