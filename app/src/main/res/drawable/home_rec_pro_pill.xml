<?xml version="1.0" encoding="utf-8"?>
<!-- Recorder home: the Pro button. Kept gold so it still reads as the upgrade, but as a flat pill
     like every other pill in Joy Creator (the old one was a three-stop gradient with 8dp corners).
     s_careful is the palette's only gold; Joy Creator has no separate "pro" token. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/s_careful" />
    <corners android:radius="13dp" />
    <padding
        android:left="10dp"
        android:right="10dp"
        android:top="4dp"
        android:bottom="4dp" />
</shape>
