<!-- Mask mode SUBTRACT: a solid circle with the second circle CUT OUT of it, and the cutter
     drawn as a thin outline so it is visible where it lies outside the solid. evenOdd on the
     two filled circles is what removes the overlap; the stroked circle on top restates where
     the cutter is. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <path android:fillColor="@android:color/white" android:fillType="evenOdd"
        android:pathData="M9,6.5a5.5,5.5 0 1,0 0,11a5.5,5.5 0 1,0 0,-11zM15,6.5a5.5,5.5 0 1,0 0,11a5.5,5.5 0 1,0 0,-11z"/>
    <path android:strokeColor="@android:color/white" android:strokeWidth="1"
        android:fillColor="@android:color/transparent"
        android:pathData="M15,6.5a5.5,5.5 0 1,0 0,11a5.5,5.5 0 1,0 0,-11z"/>
</vector>
