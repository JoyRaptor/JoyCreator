    <path
        android:fillColor="#00000000"
        android:pathData="M10,30 L10,14 Q10,10 14,10 L30,10 M66,10 L82,10 Q86,10 86,14 L86,30 M86,66 L86,82 Q86,86 82,86 L66,86 M30,86 L14,86 Q10,86 10,82 L10,66"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.5" />
