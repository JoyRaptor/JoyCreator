<!--
  A pointing-down hand (👇) — "this object is touchable in the preview" mark.

  Replaces an earlier finger-pressing-a-surface glyph the owner found illegible at 20dp. A
  closed fist with one extended index finger is a shape everyone already reads instantly — it
  is the emoji — drawn as flat fills with no gradient or stroke so it matches every other icon
  in this row. Paired with ic_touch_press_off_24, which is this exact artwork plus a slash.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Fist: folded knuckles, rounded rectangle. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8,2.6 H16 A2.2,2.2 0 0 1 18.2,4.8 V9.6 A2.2,2.2 0 0 1 16,11.8 H8
                           A2.2,2.2 0 0 1 5.8,9.6 V4.8 A2.2,2.2 0 0 1 8,2.6 Z" />
    <!-- Two knuckle seams, so the fist doesn't read as a plain box. -->
    <path
        android:fillColor="#33000000"
        android:pathData="M10.3,3 V11.4 H9.6 V3 Z" />
    <path
        android:fillColor="#33000000"
        android:pathData="M14.4,3 V11.4 H13.7 V3 Z" />

    <!-- Thumb: a comma-shaped bump on the left. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5.6,5.4 C4.3,5.4 3.5,6.7 4.1,8.1 C4.6,9.3 6.1,9.6 7,8.7
                           C7.7,8 7.6,6.7 6.9,5.9 C6.6,5.6 6.1,5.4 5.6,5.4 Z" />

    <!-- Index finger, extended straight down with a rounded fingertip. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9.4,10.4 H14.6 V17.6
                           A2.6,2.6 0 0 1 9.4,17.6 Z" />
</vector>
