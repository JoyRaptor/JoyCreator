<!--
  A finger pressing DOWN onto a surface — the "this object is touchable in the preview" mark.

  The base line is what makes it read as a press rather than a point: the fingertip meets a
  surface at the bottom of the icon and stops there. Without it the same shape is just an arrow
  or a cursor. Paired with ic_touch_press_off_24, which is this exact artwork plus a slash;
  they ship together on purpose, because a disabled state improvised later never matches.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The surface being pressed. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3.4,19.1 H20.6 V21.3 H3.4 Z" />

    <!-- The finger: rounded tip at the top, meeting the surface at the bottom. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,3.2 C13.9,3.2 15.4,4.7 15.4,6.6 V17.7 H8.6 V6.6 C8.6,4.7 10.1,3.2 12,3.2 Z" />

    <!-- Two short contact ticks, so the press has a direction even at 20dp. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5.2,15.4 L7.0,16.6 L6.0,17.9 L4.2,16.7 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M18.8,15.4 L17.0,16.6 L18.0,17.9 L19.8,16.7 Z" />
</vector>
