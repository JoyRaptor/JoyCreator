<?xml version="1.0" encoding="utf-8"?>
<!--
    The secondary action on the welcome screen.

    The Marquee §03 draws .btnghost as a FILLED pill: a filled s_raised background with
    dim ink. It had been built as an outline over the ground, which
    reads as a third state — neither the primary nor a resting control — next to a
    saturated primary.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="999dp" />
    <solid android:color="@color/s_raised" />
</shape>
