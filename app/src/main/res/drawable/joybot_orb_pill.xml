<?xml version="1.0" encoding="utf-8"?>
<!-- Joybot's gradient as a pill, for actions that belong to the assistant. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="999dp" />
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FFCC27FF"
        android:endColor="#FF5C43FD" />
</shape>
