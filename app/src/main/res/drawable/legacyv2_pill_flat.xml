<?xml version="1.0" encoding="utf-8"?>
<!-- Everything that is not the primary action: a flat raised pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/s_pressed">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/s_raised" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/s_ink" />
        </shape>
    </item>
</ripple>
