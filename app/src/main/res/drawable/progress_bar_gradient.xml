<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/s_surface" />
        </shape>
    </item>
    <!-- The Studio's own aqua-to-lime. -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="@color/s_go"
                    android:endColor="@color/s_go_end" />
            </shape>
        </clip>
    </item>
</layer-list>
