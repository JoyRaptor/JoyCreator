<?xml version="1.0" encoding="utf-8"?>
<!-- A flat settings row. It paints nothing of its own: the group card behind it is the panel,
     so rows read as one surface divided by hairlines. Press = a quiet ripple; keyboard/D-pad
     focus = a cyan-tinted wash so the highlight is visible on a remote. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/s_pressed"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <ripple android:color="@color/s_pressed">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="@color/s_on_room"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </ripple>
    </item>
</selector>
