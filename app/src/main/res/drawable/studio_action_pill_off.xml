<?xml version="1.0" encoding="utf-8"?>
<!--
  THE PRIMARY ACTION, NOT YET AVAILABLE.

  Dimming the gradient was the obvious thing and it looked wrong: a 60%-alpha
  aqua-to-lime over black comes out a muddy dark teal that reads as a rendering
  fault rather than as a disabled control. Saturation at low alpha does not say
  "off", it says "broken".

  So a disabled primary stops being coloured at all. It keeps its exact shape and
  size — nothing moves when it becomes available — and only its FILL changes, from
  the gradient to a flat raised grey. That is also the honest reading: until the
  boxes are ticked this is not the primary action, because it is not an action.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="999dp" />
    <solid android:color="@color/s_raised" />
    <stroke android:width="1dp" android:color="#FF2C2C35" />
</shape>
