<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral timer accent: a subtle rounded gradient bar that sits behind the
     elapsed timer. Replaces the former branded flag accent. Matches the app's
     dark aesthetic using the primary purple fading into a deep transparent tone. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <gradient
        android:angle="315"
        android:startColor="#00CFBAFD"
        android:centerColor="#66A88FE0"
        android:endColor="#CFBAFD"
        android:type="linear" />
    <size
        android:width="48dp"
        android:height="14dp" />
</shape>
