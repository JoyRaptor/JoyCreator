<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="45"
                android:startColor="#2700FF"
                android:centerColor="@color/s_panel"
                android:endColor="#FF004C"
                android:type="linear" />
        </shape>
    </item>
    <item android:top="10dp" android:height="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#CC00E5FF" />
        </shape>
    </item>
    <item android:top="24dp" android:height="6dp" android:left="18dp">
        <shape android:shape="rectangle">
            <solid android:color="#CCFF006E" />
        </shape>
    </item>
    <item android:top="42dp" android:height="8dp" android:right="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#CC00E5FF" />
        </shape>
    </item>
</layer-list>
