<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#80000000">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/s_raised"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/chat_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/s_ink"
            android:contentDescription="Close" />

        <!-- AI mascot, 30% larger than the toolbar icon (40dp -> 52dp), horizontally
             flipped so he faces inward (toward the title text) — he's asymmetric and
             always drawn facing the same relative direction as his position on screen. -->
        <ImageView
            android:id="@+id/chat_header_ai_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/joybot_neutral"
            app:tint="@color/s_ink"
            android:contentDescription="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/assistant_title"
                android:textColor="@color/s_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chat_model_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/s_ink_faint"
                android:textSize="10sp"
                android:singleLine="true"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/chat_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="@color/s_ink"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- Status bar (shows current tool + progress, fades when idle) -->
    <LinearLayout
        android:id="@+id/chat_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FF0D1F0D"
        android:padding="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ProgressBar
                android:id="@+id/chat_status_spinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chat_status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FF4CAF50"
                android:textSize="12sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/chat_status_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/s_ink_faint"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/chat_status_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <!-- Task checklist -->
        <LinearLayout
            android:id="@+id/chat_checklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Messages + ticker -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/chat_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbarStyle="insideOverlay">

            <LinearLayout
                android:id="@+id/chat_messages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/chat_ticker"
            android:layout_width="18dp"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#44000000"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </RelativeLayout>

    <!-- Input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/s_raised"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/chat_attach"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_gallery"
            android:tint="@color/s_ink_faint"
            android:contentDescription="Attach image" />

        <EditText
            android:id="@+id/chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Ask anything..."
            android:textColorHint="@color/s_ink_off"
            android:textColor="@color/s_ink"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:maxLines="4"
            android:inputType="textMultiLine|textCapSentences" />

        <ImageButton
            android:id="@+id/chat_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#FF4CAF50"
            android:contentDescription="Voice input" />

        <ImageButton
            android:id="@+id/chat_send"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_send"
            android:tint="#FF4CAF50"
            android:contentDescription="Send" />
    </LinearLayout>
</LinearLayout>
