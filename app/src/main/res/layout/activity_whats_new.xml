<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/whatsNewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/s_ground"
    android:fitsSystemWindows="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:paddingBottom="8dp">

        <!-- How far through the notes you are: the Studio's aqua-to-lime -->
        <ProgressBar
            android:id="@+id/scrollProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:contentDescription="@string/legacyv2_whatsnew_progress_desc"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_gradient" />

        <!-- Header: close on the left, title beside it -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/btnCloseWhatsNew"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/desc_close"
                android:focusable="true"
                android:fontFamily="@font/materialicons"
                android:gravity="center"
                android:text="close"
                android:textColor="@color/s_ink_dim"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/whatsNewTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="@string/legacyv2_whatsnew_title"
                android:textColor="@color/s_ink"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Info card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="4dp"
            android:background="@drawable/legacyv2_card"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/whatsNewIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="1dp"
                android:text="@string/legacyv2_whatsnew_intro"
                android:textColor="@color/s_ink"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/whatsNewReenable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/legacyv2_whatsnew_reenable"
                android:textColor="@color/s_ink_faint"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="8dp"
            android:background="@color/s_line"
            android:importantForAccessibility="no" />

        <!-- Loading placeholder bars -->
        <LinearLayout
            android:id="@+id/shimmerContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="1dp"
            android:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/legacyv2_shimmer_bar" />

            <View
                android:layout_width="280dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/legacyv2_shimmer_bar" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/legacyv2_shimmer_bar" />

            <View
                android:layout_width="260dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/legacyv2_shimmer_bar" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/legacyv2_shimmer_bar" />

            <View
                android:layout_width="240dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/legacyv2_shimmer_bar" />
        </LinearLayout>

        <!-- Changelog WebView (supports images) -->
        <WebView
            android:id="@+id/changelogWebView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:paddingTop="1dp"
            android:visibility="gone" />

        <!-- Bottom action with countdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/countdownText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="@color/s_ink_faint"
                android:textSize="10sp"
                tools:text="Ready in 3 seconds..." />

            <TextView
                android:id="@+id/btnGotIt"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:alpha="0.5"
                android:background="@drawable/legacyv2_pill_primary"
                android:enabled="false"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/legacyv2_whatsnew_got_it"
                android:textColor="@color/s_on_go"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
