<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/legacyv2_grab"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tv_beta_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/legacyv2_disc"
        android:fontFamily="@font/materialicons"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:text="science"
        android:textColor="@color/s_guide"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/tv_beta_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:text="@string/update_beta_title"
        android:textColor="@color/s_ink"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tv_beta_sheet_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:textColor="@color/s_guide"
        android:textSize="14sp"
        tools:text="v4.0.0  →  v4.0.0-beta9" />

    <TextView
        android:id="@+id/tv_beta_sheet_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/update_beta_desc"
        android:textColor="@color/s_ink_dim"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btn_beta_get"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/legacyv2_pill_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/update_get_beta"
        android:textColor="@color/s_on_go"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btn_beta_dismiss"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/legacyv2_pill_flat"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/update_maybe_later"
        android:textColor="@color/s_ink"
        android:textSize="14sp" />

</LinearLayout>
