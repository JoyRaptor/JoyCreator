<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/legacyv2_grab"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/tv_pro_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/legacyv2_disc"
        android:importantForAccessibility="no"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_crown"
        app:tint="@color/s_careful" />

    <TextView
        android:id="@+id/tv_pro_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:text="@string/legacyv2_update_pro_title"
        android:textColor="@color/s_ink"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tv_pro_sheet_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:textColor="@color/s_careful"
        android:textSize="14sp"
        tools:text="v4.0.0  →  v5.0.0" />

    <TextView
        android:id="@+id/tv_pro_sheet_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/legacyv2_update_pro_desc"
        android:textColor="@color/s_ink_dim"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btn_pro_get"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/legacyv2_pill_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/legacyv2_update_get_pro"
        android:textColor="@color/s_on_go"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btn_pro_dismiss"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/legacyv2_pill_flat"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/update_maybe_later"
        android:textColor="@color/s_ink"
        android:textSize="14sp" />

</LinearLayout>
