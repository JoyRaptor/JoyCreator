<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Header bar (consistent with other tabs) -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@drawable/header_bar_rounded_bg">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nav_faditor_mini"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="start|center_vertical"
                android:textAlignment="viewStart" />

            <!-- Avatar Studio (standalone, library-backed) — avatars serve both
                 the screen recorder and the editor, so the entry lives on the
                 main surface next to the editor branding. -->
            <ImageView
                android:id="@+id/btn_avatar_studio"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Avatar Studio"
                android:padding="1dp"
                android:src="@drawable/ic_person_24"
                android:tint="@android:color/white" />

            <ImageView
                android:id="@+id/btn_info"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/video_menu_info"
                android:padding="2dp"
                android:src="@drawable/ic_info"
                android:tint="@android:color/white" />
        </LinearLayout>

        <!-- Export dock (hidden by default) -->
        <LinearLayout
            android:id="@+id/faditor_export_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_records_delete_dock"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Top row: icon, title, completion button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/faditor_export_dock_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check_circle"
                    android:tint="@android:color/white"
                    android:contentDescription="@string/export_status" />

                <com.fadcam.ui.utils.AnimatedTextView
                    android:id="@+id/faditor_export_dock_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/faditor_export_progress"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.fadcam.ui.utils.AnimatedTextView
                    android:id="@+id/faditor_export_dock_ok"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_records_delete_ok_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="58dp"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="@string/records_delete_header_action_ok"
                    android:textAllCaps="true"
                    android:textColor="#17305B"
                    android:textSize="12sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Progress bar -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/faditor_export_dock_progress"
                style="@style/Widget.Material3.LinearProgressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="30"
                app:trackThickness="8dp"
                app:trackColor="#40FFFFFF"
                app:indicatorColor="@android:color/white" />

            <!-- Current item and ETA row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/faditor_export_dock_current"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    tools:text="Exporting project..." />

                <TextView
                    android:id="@+id/faditor_export_dock_eta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    tools:text="ETA 14s" />
            </LinearLayout>

            <!-- Summary line (optional) -->
            <TextView
                android:id="@+id/faditor_export_dock_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/s_ink_60"
                android:textSize="12sp"
                android:paddingBottom="4dp"
                tools:text="1.2 GB / 2.5 GB" />

            <!-- Result row: the finished video, on completion only. "OK" alone left the user
                 with nothing to DO about the thing they just made — this is the tap that plays
                 it and the one that goes to find it. -->
            <LinearLayout
                android:id="@+id/faditor_export_dock_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:id="@+id/faditor_export_dock_thumb_wrap"
                    android:layout_width="76dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_dark_rounded"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/faditor_export_dock_thumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/faditor_export_result_play" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play"
                        android:tint="@android:color/white"
                        android:alpha="0.92"
                        android:contentDescription="@string/faditor_export_result_play" />
                </FrameLayout>

                <TextView
                    android:id="@+id/faditor_export_dock_open_records"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/faditor_export_result_open_records"
                    android:textColor="@color/s_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="76dp"
        android:focusable="false"
        android:descendantFocusability="afterDescendants">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ─── Hero card (modern, compact) ────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                android:padding="18dp"
                android:background="@drawable/settings_group_card_bg">

                <!-- Top row: icon + text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Accent icon container -->
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:fontFamily="@font/materialicons"
                            android:text="movie_edit"
                            android:textColor="@color/s_go"
                            android:textSize="28sp" />
                    </FrameLayout>

                    <!-- Title + tagline -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/faditor_mini_title"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/faditor_home_tagline"
                            android:textSize="12sp"
                            android:textColor="@color/s_ink_faint"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Start Project button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_select_video"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/faditor_start_project"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    app:backgroundTint="@color/s_go"
                    app:cornerRadius="12dp"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />
            </LinearLayout>

            <!-- ─── Empty state (no projects) ───────────────────── -->
            <LinearLayout
                android:id="@+id/empty_state_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Section heading -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faditor_recent_projects"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorHeading"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="16dp" />

                <!-- Centered empty content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/materialicons"
                        android:text="video_library"
                        android:textColor="@color/s_off"
                        android:textSize="48sp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/faditor_empty_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/s_ink_faint"
                        android:textAlignment="center"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/faditor_empty_desc"
                        android:textSize="13sp"
                        android:textColor="@color/s_ink_off"
                        android:textAlignment="center"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ─── Recent Projects section ──────────────────────── -->
            <LinearLayout
                android:id="@+id/recent_projects_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <!-- Section header row: title + delete action -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/faditor_recent_projects"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorHeading"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08" />

                    <!-- Project count badge -->
                    <TextView
                        android:id="@+id/project_count_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/s_ink_faint"
                        android:layout_marginStart="6dp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Selection mode toggle (long-press hint) -->
                    <TextView
                        android:id="@+id/btn_select_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/materialicons"
                        android:text="checklist"
                        android:textColor="@color/s_ink_off"
                        android:textSize="22sp"
                        android:padding="4dp" />
                </LinearLayout>

                <!-- Selection action bar (hidden by default) -->
                <LinearLayout
                    android:id="@+id/selection_action_bar"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/settings_group_card_bg"
                    android:visibility="gone">

                    <!-- Select all checkbox -->
                    <CheckBox
                        android:id="@+id/cb_select_all"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:padding="0dp"
                        app:buttonTint="@color/s_go" />

                    <TextView
                        android:id="@+id/tv_selection_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/faditor_select_items"
                        android:textColor="@color/s_ink_dim"
                        android:textSize="13sp"
                        android:layout_marginStart="4dp" />

                    <!-- Delete selected -->
                    <TextView
                        android:id="@+id/btn_delete_selected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/materialicons"
                        android:text="delete"
                        android:textColor="#EF5350"
                        android:textSize="22sp"
                        android:padding="6dp" />

                    <!-- Cancel selection -->
                    <TextView
                        android:id="@+id/btn_cancel_selection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/materialicons"
                        android:text="close"
                        android:textColor="@color/s_ink_faint"
                        android:textSize="22sp"
                        android:padding="6dp" />
                </LinearLayout>

                <!-- Actual project items list -->
                <LinearLayout
                    android:id="@+id/recent_projects_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
