<?xml version="1.0" encoding="utf-8"?>
<!--
  THE LOBBY — Joy Creator's front door (design record 04, "The Marquee").

  Two halves with two different jobs:
    TOP     navigates by CATEGORY and is alive. A wrap-around carousel of room
            titles, and a hero that is whatever that room last made.
    BOTTOM  navigates by RECENCY, then never moves.

  Structure only. The marquee, the recents, the New row and the floor are all
  built in LobbyFragment so a new room costs one entry in one array rather than
  a layout edit — which is the whole point of the carousel.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/studio_ground">

    <LinearLayout
        android:id="@+id/lobby_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── The export hairline. JoyRaptor: "out of the way and it just adds a nice
             highlight color." It replaced a 58dp frosted strip, and the height it gave
             back is what the New row and Joybot's line now occupy. ─────────────── -->
        <View
            android:id="@+id/lobby_hairline"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/studio_panel"
            android:visibility="gone" />

        <!-- ── Chrome ──────────────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/lobby_chrome"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/lobby_wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Joy Creator"
                android:textColor="#FFE4E4E7"
                android:textSize="16sp"
                android:maxLines="1"
                android:singleLine="true"
                android:letterSpacing="-0.03" />

            <!-- Cycling stat: everything the old Home spent five cards on, in one line
                 that changes every few seconds. Locks to amber when storage is low. -->
            <LinearLayout
                android:id="@+id/lobby_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/lobby_stat_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/materialicons"
                    android:text="storage"
                    android:textColor="#FF71717A"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/lobby_stat_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFA1A1AA"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/lobby_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:fontFamily="@font/materialicons"
                android:text="search"
                android:textColor="#FFA1A1AA"
                android:textSize="19sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search everything" />

            <TextView
                android:id="@+id/lobby_bot"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:gravity="center"
                android:fontFamily="@font/materialicons"
                android:text="smart_toy"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:contentDescription="Joybot" />
        </LinearLayout>

        <!-- ── The marquee. Titles grow from thin grey to heavy white as they arrive. ── -->
        <HorizontalScrollView
            android:id="@+id/lobby_marquee_scroll"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/lobby_marquee"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:paddingStart="18dp"
                android:paddingEnd="44dp" />
        </HorizontalScrollView>

        <!-- ── HERO. Full bleed: no side gutter, no radius. The one deliberate break
             of the 18dp margin on this screen. ─────────────────────────────────── -->
        <FrameLayout
            android:id="@+id/lobby_hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="30"
            android:minHeight="150dp"
            android:maxHeight="360dp"
            android:clipChildren="true">

            <ImageView
                android:id="@+id/lobby_hero_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <!-- A wash so the tag and the bottom edge stay readable on any artwork. -->
            <View
                android:id="@+id/lobby_hero_wash"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/lobby_hero_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="18dp"
                android:layout_marginTop="14dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text=""
                android:textColor="#FFEEEEF2"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:singleLine="true" />

            <!-- Empty-state copy, shown when a room has made nothing yet. -->
            <TextView
                android:id="@+id/lobby_hero_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="34dp"
                android:paddingEnd="34dp"
                android:text=""
                android:textColor="#FF9A9AA6"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- The room's 3dp signature along the bottom edge. Corners belong to the
                 small cards; a full-bleed hero gets an edge instead. -->
            <View
                android:id="@+id/lobby_hero_bar"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom" />
        </FrameLayout>

        <!-- ── Hero meta + the screen's one saturated control ──────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lobby_hero_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFE4E4E7"
                    android:textSize="18sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:letterSpacing="-0.03" />

                <TextView
                    android:id="@+id/lobby_hero_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FF71717A"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/lobby_hero_action"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="104dp"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text=""
                android:textColor="#FF050507"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:singleLine="true" />
        </LinearLayout>

        <!-- ── Carry on ───────────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/lobby_library_door"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/lobby_library_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lobby_library"
                android:textColor="#FFE4E4E7"
                android:textSize="19sp"
                android:letterSpacing="-0.04" />

            <TextView
                android:id="@+id/lobby_library_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:layout_marginBottom="2dp"
                android:text=""
                android:textColor="#FF71717A"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/materialicons"
                android:text="chevron_right"
                android:textColor="#FF71717A"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/lobby_carry_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:text="@string/lobby_carry_on"
            android:textColor="#FF71717A"
            android:textSize="10sp" />

        <HorizontalScrollView
            android:id="@+id/lobby_recents_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/lobby_recents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp" />
        </HorizontalScrollView>

        <!-- ── NEW. Grey buttons with full-strength coloured glyphs, so the hero's
             action stays the only saturated control on the screen. ───────────── -->
        <LinearLayout
            android:id="@+id/lobby_new_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp" />

        <!-- ── Joybot's one line: the only thing on the screen that changes because
             of what you DID rather than what you tapped. ───────────────────────── -->
        <LinearLayout
            android:id="@+id/lobby_bot_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="12dp"
            android:paddingTop="13dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/lobby_bot_line_orb"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:fontFamily="@font/materialicons"
                android:text="smart_toy"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/lobby_bot_line_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:text=""
                android:textColor="#FFA1A1AA"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/lobby_bot_line_yes"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text=""
                android:textColor="#FF050507"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lobby_bot_line_no"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:fontFamily="@font/materialicons"
                android:text="close"
                android:textColor="#FF4B4B55"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Dismiss" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3" />

        <!-- ── The floor. Stable, quiet, never moves. Same typographic instrument as
             the marquee, played softly. ────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/lobby_floor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp" />
    </LinearLayout>
</FrameLayout>
