<?xml version="1.0" encoding="utf-8"?>
<!--
  THE LOBBY — Joy Creator's front door (design record 04, "The Marquee").

  Two halves with two different jobs:
    TOP     navigates by CATEGORY and is alive. A wrap-around carousel of room
            titles, and a hero that is whatever that room last made.
    BOTTOM  navigates by RECENCY, then never moves.

  Structure only. The marquee, the recents, the New row and the floor are all
  built in LobbyFragment so a new room costs one entry in one array rather than
  a layout edit — which is the whole point of the carousel.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/studio_ground">

    <LinearLayout
        android:id="@+id/lobby_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <!-- ── The export hairline. JoyRaptor: "out of the way and it just adds a nice
             highlight color." It replaced a 58dp frosted strip, and the height it gave
             back is what the New row and Joybot's line now occupy. ─────────────── -->
        <View
            android:id="@+id/lobby_hairline"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/studio_panel"
            android:visibility="gone" />

        <!-- ══ CHROME ═══════════════════════════════════════════════════
             JoyRaptor's neon banner replaces the wordmark TEXT and becomes the backdrop for
             the whole top line: "it will sit as a backdrop for the top line sitting right
             above the Studio Capture Carousel."

             Band 1 of the six, chosen over the bottom band because its right-hand side
             fades into a dark grid, while the bottom one puts a bright setting sun exactly
             where the storage readout, the search and Joybot have to stay legible.

             Even so the art is neon and the controls are grey, so a scrim fades black in
             from the right: clear over the lettering, solid under the controls.

             Full-bleed and LEFT-anchored, because the wordmark is baked into the art at its
             left edge — centring would walk it off the 18dp gutter on every other screen
             width. The row grew from 52dp to 60dp to give the art room to read.
             ══════════════════════════════════════════════════════════ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/lobby_banner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="matrix"
                android:contentDescription="@string/app_name" />

            <View
                android:id="@+id/lobby_banner_scrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/lobby_chrome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/lobby_wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Joy Creator"
                android:textColor="#00000000"
                android:textSize="16sp"
                android:maxLines="1"
                android:singleLine="true"
                android:letterSpacing="-0.03" />

            <!-- Cycling stat: everything the old Home spent five cards on, in one line
                 that changes every few seconds. Locks to amber when storage is low. -->
            <LinearLayout
                android:id="@+id/lobby_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/lobby_stat_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/materialicons"
                    android:text="storage"
                    android:textColor="#FF71717A"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/lobby_stat_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFA1A1AA"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/lobby_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:fontFamily="@font/materialicons"
                android:text="search"
                android:textColor="#FFA1A1AA"
                android:textSize="19sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search everything" />

            <!-- ── JOYBOT ─────────────────────────────────────────────────────
                 JoyRaptor's own art, two frames, registered on the HANDS — his widest span — and
                 aligned on the bottom of them. This slot used to hold
                 the Material "smart_toy" glyph, which is a generic robot head shipped with
                 the icon font and used by thousands of apps — the single most borrowed
                 element on the screen, standing in for the one thing that is entirely this
                 product's own.

                 40dp rather than the old 34dp: he now has a body and a base below the head,
                 so the same optical size needs more box. ──────────────────────────── -->
            <com.fadcam.ui.lobby.JoybotView
                android:id="@+id/lobby_bot"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:contentDescription="Joybot" />
        </LinearLayout>
        </FrameLayout>

        <!-- ── THE MARQUEE ──────────────────────────────────────────────
             Titles grow from thin grey to heavy white as they arrive.

             JoyRaptor: "make the word studio larger" and leave "more open space up top
             between the app title and the words carosel". Both are here: the live word went
             from 27sp to 34sp, which needs 66dp of box rather than 52dp, and the 12dp margin
             is the gap itself.

             The gap matters more than it looks. The wordmark and the live marquee word are
             both Archivo Black; set close together they read as one two-line title and the
             carousel stops looking like something you can touch. Separating them says they
             are different KINDS of thing. ────────────────────────────────── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="12dp">

        <HorizontalScrollView
            android:id="@+id/lobby_marquee_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:fillViewport="false">

            <!-- paddingEnd is a screen's worth of trailing room, not a typo. Without it the
                 strip cannot scroll far enough to bring its LAST words to the gutter:
                 scrollTo clamps at the content edge, the snap lands short, and the word that
                 was sized 34sp ends up sitting right of the one actually in the gutter. It
                 is the standard cost of a snapping scroller, and it is invisible — empty
                 space past the end of a strip that already wraps. -->
            <LinearLayout
                android:id="@+id/lobby_marquee"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:paddingStart="18dp"
                android:paddingEnd="420dp" />
        </HorizontalScrollView>

        <!-- Not clickable and not focusable, so it is painted over the strip without
             taking a single touch away from it: the words underneath stay tappable and
             the whole width still drags. -->
        <View
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:clickable="false"
            android:focusable="false"
            android:background="@drawable/lobby_marquee_fade" />
        </FrameLayout>

        <!-- ── HERO. Full bleed: no side gutter, no radius. The one deliberate break
             of the 18dp margin on this screen. ─────────────────────────────────── -->
        <FrameLayout
            android:id="@+id/lobby_hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="26"
            android:minHeight="150dp"
            android:maxHeight="300dp"
            android:clipChildren="true">

            <ImageView
                android:id="@+id/lobby_hero_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <!-- A wash so the tag and the bottom edge stay readable on any artwork. -->
            <View
                android:id="@+id/lobby_hero_wash"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/lobby_hero_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="18dp"
                android:layout_marginTop="14dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text=""
                android:textColor="#FFEEEEF2"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:singleLine="true" />

            <!-- Empty-state copy, shown when a room has made nothing yet. -->
            <TextView
                android:id="@+id/lobby_hero_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="34dp"
                android:paddingEnd="34dp"
                android:text=""
                android:textColor="#FF9A9AA6"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- The room's 3dp signature along the bottom edge. Corners belong to the
                 small cards; a full-bleed hero gets an edge instead. -->
            <View
                android:id="@+id/lobby_hero_bar"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom" />
        </FrameLayout>

        <!-- ── Hero meta + the screen's one saturated control ──────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lobby_hero_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFE4E4E7"
                    android:textSize="18sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:letterSpacing="-0.03" />

                <TextView
                    android:id="@+id/lobby_hero_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FF71717A"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/lobby_hero_new"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp"
                android:text="@string/lobby_hero_new"
                android:textColor="#FFA1A1AA"
                android:textSize="12.5sp"
                android:maxLines="1"
                android:singleLine="true" />

            <TextView
                android:id="@+id/lobby_hero_action"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="104dp"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text=""
                android:textColor="#FF050507"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:singleLine="true" />
        </LinearLayout>

        <!-- ── Carry on ───────────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/lobby_library_door"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="30dp"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/lobby_library_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lobby_library"
                android:textColor="#FFE4E4E7"
                android:textSize="19sp"
                android:letterSpacing="-0.04" />

            <TextView
                android:id="@+id/lobby_library_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:layout_marginBottom="2dp"
                android:text=""
                android:textColor="#FF71717A"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/materialicons"
                android:text="chevron_right"
                android:textColor="#FF71717A"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/lobby_carry_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:text="@string/lobby_carry_on"
            android:textColor="#FF71717A"
            android:textSize="10sp" />

        <HorizontalScrollView
            android:id="@+id/lobby_recents_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/lobby_recents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp" />
        </HorizontalScrollView>

        <!-- ── NEW ────────────────────────────────────────────────────
             Four sheared chips filled with their room's gradient, glyph punched out in pure
             black. Built in code — see addNewChip — because the shear is a custom path and
             not something a shape drawable can describe.

             paddingEnd is 8dp here rather than the screen's usual 18dp ON PURPOSE. The last
             chip's right edge leans away from the gutter, so measuring it flush leaves a
             wedge of dead space that reads as a mistake; letting the row run a little wider
             puts the leaning edge where the eye expects the margin to be. ────────────── -->
        <LinearLayout
            android:id="@+id/lobby_new_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="18dp"
            android:paddingEnd="8dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <!-- ── Joybot's one line: the only thing on the screen that changes because
             of what you DID rather than what you tapped. ───────────────────────── -->
        <LinearLayout
            android:id="@+id/lobby_bot_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="12dp"
            android:paddingTop="13dp"
            android:visibility="gone">

            <com.fadcam.ui.lobby.JoybotView
                android:id="@+id/lobby_bot_line_orb"
                android:layout_width="26dp"
                android:layout_height="26dp" />

            <TextView
                android:id="@+id/lobby_bot_line_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:text=""
                android:textColor="#FFA1A1AA"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/lobby_bot_line_yes"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text=""
                android:textColor="#FF050507"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lobby_bot_line_no"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:fontFamily="@font/materialicons"
                android:text="close"
                android:textColor="#FF4B4B55"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Dismiss" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3" />

        <!-- ── The floor. Stable, quiet, never moves. Same typographic instrument as
             the marquee, played softly. ────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/lobby_floor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp" />
    </LinearLayout>
</FrameLayout>
