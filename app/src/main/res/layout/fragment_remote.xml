<?xml version="1.0" encoding="utf-8"?>
<!--
  REMOTE (once "Server Room"). Old-black ground, one flat header, then five labelled groups:
  ON AIR / CONNECTION / HEALTH / SECURITY / HELP. Every view id the fragment reads is kept; only the
  look moved to the Studio tokens (studio_tokens.xml) and the shared styles in styles_remote.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/s_ground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="76dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:focusable="false"
        android:descendantFocusability="afterDescendants">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- ══ HEADER: the title and the ON AIR / OFF AIR chip ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/remote_title"
                    android:textSize="30sp"
                    android:textColor="@color/s_ink"
                    android:fontFamily="@font/joy_display"
                    android:textFontWeight="800"
                    android:textAllCaps="true"
                    android:includeFontPadding="false"
                    android:accessibilityHeading="true" />

            </LinearLayout>

            <!-- The chip: solid Studio green with the words cut out when live, a zinc chip when idle.
                 RemoteFragment (applyOnAirChip) swaps in the sheared face; this is its first draw. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:id="@+id/status_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/remote_chip_off_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Glow container + indicator dot -->
                    <FrameLayout
                        android:id="@+id/glow_container"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <View
                            android:id="@+id/status_glow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:background="@drawable/status_dot_glow"
                            android:visibility="gone" />

                        <View
                            android:id="@+id/status_indicator_dot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="center"
                            android:background="@drawable/status_dot_inactive" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/remote_chip_off_air"
                        android:textSize="13sp"
                        android:textColor="@color/s_ink_dim"
                        android:fontFamily="@font/joy_mono"
                        android:textFontWeight="600"
                        android:letterSpacing="0.14"
                        android:includeFontPadding="false"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="@string/remote_server_status"
                    android:textSize="11sp"
                    android:textColor="@color/s_ink_faint"
                    android:fontFamily="@font/joy_mono"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true" />
            </LinearLayout>

            <!-- ══ ON AIR ══ -->
            <TextView
                android:id="@+id/remote_section_on_air_label"
                style="@style/Remote.Section"
                android:text="@string/remote_section_on_air" />

            <!-- Usage reporting status card (appears when there are errors/warnings) -->
            <LinearLayout
                android:id="@+id/usage_reporting_warning_card"
                style="@style/Remote.Card"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:id="@+id/usage_warning_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_error"
                        android:tint="@color/s_careful"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/usage_warning_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/remote_usage_title"
                            android:textSize="13sp"
                            android:textColor="@color/s_ink"
                            android:fontFamily="@font/joy_body"
                            android:textFontWeight="600" />

                        <com.fadcam.ui.utils.AnimatedTextView
                            android:id="@+id/usage_warning_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/remote_usage_retrying"
                            android:textSize="11sp"
                            android:textColor="@color/s_ink_dim"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Detailed metrics -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="32dp"
                    android:paddingEnd="0dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/remote_usage_bytes"
                            android:textSize="9sp"
                            android:textColor="@color/s_ink_faint"
                            android:fontFamily="@font/joy_mono"
                            android:textFontWeight="500" />

                        <com.fadcam.ui.utils.AnimatedTextView
                            android:id="@+id/usage_warning_bytes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 B"
                            android:textSize="10sp"
                            android:textColor="@color/s_ink"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/remote_usage_failures"
                            android:textSize="9sp"
                            android:textColor="@color/s_ink_faint"
                            android:fontFamily="@font/joy_mono"
                            android:textFontWeight="500" />

                        <com.fadcam.ui.utils.AnimatedTextView
                            android:id="@+id/usage_warning_failures"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/50"
                            android:textSize="10sp"
                            android:textColor="@color/s_ink"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/remote_usage_action"
                            android:textSize="9sp"
                            android:textColor="@color/s_ink_faint"
                            android:fontFamily="@font/joy_mono"
                            android:textFontWeight="500" />

                        <TextView
                            android:id="@+id/usage_warning_test_link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/remote_usage_retry"
                            android:textSize="10sp"
                            android:textColor="@color/s_armed"
                            android:layout_marginTop="1dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Remote.Card">

                <!-- Start server toggle -->
                <LinearLayout
                    android:id="@+id/row_start_server"
                    style="@style/Remote.Row">

                    <TextView
                        style="@style/Remote.RowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/stream_start_server" />

                    <com.fadcam.ui.joybot.JoybotSwitch
                        android:id="@+id/streaming_toggle" android:contentDescription="@string/stream_start_server"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Server URL, with the copy chip -->
                <LinearLayout
                    android:id="@+id/root_url_container"
                    style="@style/Remote.Row">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Remote.RowTitle"
                            android:text="@string/stream_server_url" />

                        <TextView
                            android:id="@+id/root_url_text"
                            style="@style/Remote.RowValue"
                            android:text="http://---.---.---.---:----/"
                            android:textSize="13sp"
                            android:textColor="@color/s_ink"
                            android:fontFamily="@font/joy_mono" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/copy_root_button"
                        android:layout_width="56dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_copy"
                        android:tint="@color/s_on_go"
                        android:background="@drawable/remote_copy_chip_bg"
                        android:contentDescription="@string/desc_copy_url"
                        android:tooltipText="@string/desc_copy_url"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- View all endpoints -->
                <LinearLayout
                    android:id="@+id/view_endpoints_row"
                    style="@style/Remote.Row">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Remote.RowTitle"
                            android:text="@string/stream_view_all_endpoints" />

                        <TextView
                            style="@style/Remote.RowValue"
                            android:text="@string/stream_view_all_endpoints_desc" />
                    </LinearLayout>

                    <ImageView style="@style/Remote.Chevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══ CONNECTION ══ -->
            <TextView
                android:id="@+id/remote_section_connection_label"
                style="@style/Remote.Section"
                android:text="@string/remote_section_connection" />

            <LinearLayout style="@style/Remote.Card">

                <!-- Recording mode -->
                <LinearLayout
                    android:id="@+id/recording_mode_row"
                    style="@style/Remote.Row">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Remote.RowTitle"
                            android:text="@string/stream_recording_mode" />

                        <TextView
                            android:id="@+id/recording_mode_value"
                            style="@style/Remote.RowValue"
                            android:text="@string/stream_only_desc" />
                    </LinearLayout>

                    <ImageView style="@style/Remote.Chevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Quality preset -->
                <LinearLayout
                    android:id="@+id/fps_format_row"
                    style="@style/Remote.Row">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Remote.RowTitle"
                            android:text="@string/stream_quality_preset" />

                        <TextView
                            android:id="@+id/fps_resolution_text"
                            style="@style/Remote.RowValue"
                            android:text="@string/remote_quality_default" />
                    </LinearLayout>

                    <ImageView style="@style/Remote.Chevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══ HEALTH ══ -->
            <TextView
                android:id="@+id/remote_section_health_label"
                style="@style/Remote.Section"
                android:text="@string/remote_section_health" />

            <LinearLayout style="@style/Remote.Card">

                <!-- Grid 1: uptime / clients, battery / segments -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Uptime -->
                        <LinearLayout
                            android:id="@+id/uptime_row"
                            style="@style/Remote.Tile"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Remote.TileLabel"
                                    android:text="@string/stream_uptime_label" />

                                <TextView
                                    android:id="@+id/uptime_text"
                                    style="@style/Remote.TileValue"
                                    android:text="0s" />
                            </LinearLayout>

                            <ImageView style="@style/Remote.Chevron" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/s_line"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp" />

                        <!-- Battery -->
                        <LinearLayout
                            android:id="@+id/battery_row"
                            style="@style/Remote.Tile"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Remote.TileLabel"
                                    android:text="@string/stream_battery_label" />

                                <TextView
                                    android:id="@+id/battery_text"
                                    style="@style/Remote.TileValue"
                                    android:text="--" />
                            </LinearLayout>

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="28dp"
                                android:layout_marginEnd="8dp"
                                android:layout_gravity="center_vertical">
                                <com.fadcam.ui.utils.StorageProgressRingView
                                    android:id="@+id/battery_progress_ring"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/desc_battery_used" />
                            </FrameLayout>

                            <ImageView style="@style/Remote.Chevron" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/s_line"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Clients -->
                        <LinearLayout
                            android:id="@+id/clients_row"
                            style="@style/Remote.Tile">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Remote.TileLabel"
                                    android:text="@string/stream_clients_label" />

                                <TextView
                                    android:id="@+id/connections_text"
                                    style="@style/Remote.TileValue"
                                    android:text="0" />
                            </LinearLayout>

                            <ImageView style="@style/Remote.Chevron" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/s_line"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp" />

                        <!-- Segments -->
                        <LinearLayout
                            android:id="@+id/segments_row"
                            style="@style/Remote.Tile"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Remote.TileLabel"
                                    android:text="@string/stream_segments_label" />

                                <TextView
                                    android:id="@+id/fragments_text"
                                    style="@style/Remote.TileValue"
                                    android:text="0" />
                            </LinearLayout>

                            <ImageView style="@style/Remote.Chevron" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Grid 2: network / memory, storage / data -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Network health -->
                        <LinearLayout
                            android:id="@+id/network_health_row"
                            style="@style/Remote.Tile"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Remote.TileLabel"
                                    android:text="@string/stream_network_label" />

                                <TextView
                                    android:id="@+id/network_health_text"
                                    style="@style/Remote.TileValue"
                                    android:text="--" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/network_wifi_bars"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_gravity="center_vertical"
                                android:gravity="bottom"
                                android:padding="2dp"
                                android:layout_marginEnd="8dp">
                                <View android:id="@+id/wifi_bar1" android:layout_width="2dp" android:layout_height="3dp" android:background="@color/s_off" android:layout_marginEnd="1dp"/>
                                <View android:id="@+id/wifi_bar2" android:layout_width="2dp" android:layout_height="5dp" android:background="@color/s_off" android:layout_marginEnd="1dp"/>
                                <View android:id="@+id/wifi_bar3" android:layout_width="2dp" android:layout_height="7dp" android:background="@color/s_off" android:layout_marginEnd="1dp"/>
                                <View android:id="@+id/wifi_bar4" android:layout_width="2dp" android:layout_height="9dp" android:background="@color/s_off" />
                            </LinearLayout>

                            <ImageView style="@style/Remote.Chevron" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/s_line"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp" />

                        <!-- Storage -->
                        <LinearLayout style="@style/Remote.Tile">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Remote.TileLabel"
                                    android:text="@string/stream_storage_label" />

                                <TextView
                                    android:id="@+id/storage_text"
                                    style="@style/Remote.TileValue"
                                    android:text="--" />
                            </LinearLayout>

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center_vertical">
                                <com.fadcam.ui.utils.StorageProgressRingView
                                    android:id="@+id/remote_storage_progress_ring"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/desc_storage_used" />
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/s_line"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Memory -->
                        <LinearLayout style="@style/Remote.Tile">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Remote.TileLabel"
                                    android:text="@string/stream_memory_label" />

                                <TextView
                                    android:id="@+id/memory_text"
                                    style="@style/Remote.TileValue"
                                    android:text="--" />
                            </LinearLayout>

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center_vertical">
                                <com.fadcam.ui.utils.StorageProgressRingView
                                    android:id="@+id/remote_memory_progress_ring"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/desc_memory_used" />
                            </FrameLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/s_line"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp" />

                        <!-- Data transferred -->
                        <LinearLayout
                            android:id="@+id/data_sent_row"
                            style="@style/Remote.Tile"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Remote.TileLabel"
                                    android:text="@string/stream_data_sent_label" />

                                <TextView
                                    android:id="@+id/data_transferred_text"
                                    style="@style/Remote.TileValue"
                                    android:text="0 MB" />
                            </LinearLayout>

                            <ImageView style="@style/Remote.Chevron" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Remote Security -->
            <TextView
                android:id="@+id/remote_security_heading"
                style="@style/Remote.Section"
                android:paddingTop="16dp"
                android:text="@string/remote_security_title" />

            <LinearLayout
                android:id="@+id/remote_security_container"
                style="@style/Remote.Card">

                <!-- Enable authentication -->
                <LinearLayout
                    android:id="@+id/remote_auth_enable_row"
                    style="@style/Remote.Row">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Remote.RowTitle"
                            android:text="@string/remote_security_enable" />

                        <TextView
                            style="@style/Remote.RowValue"
                            android:text="@string/remote_security_enable_desc" />
                    </LinearLayout>

                    <com.fadcam.ui.joybot.JoybotSwitch
                        android:id="@+id/remote_auth_toggle" android:contentDescription="@string/remote_security_enable"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Set password -->
                <LinearLayout
                    android:id="@+id/remote_auth_password_row"
                    style="@style/Remote.Row"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Remote.RowTitle"
                            android:text="@string/remote_security_password" />

                        <TextView
                            android:id="@+id/remote_auth_password_value"
                            style="@style/Remote.RowValue"
                            android:text="@string/remote_security_password_desc" />
                    </LinearLayout>

                    <ImageView style="@style/Remote.Chevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Auto-lock timeout -->
                <LinearLayout
                    android:id="@+id/remote_auth_auto_lock_row"
                    style="@style/Remote.Row"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Remote.RowTitle"
                            android:text="@string/remote_security_auto_lock" />

                        <TextView
                            android:id="@+id/remote_auth_auto_lock_value"
                            style="@style/Remote.RowValue"
                            android:text="@string/remote_security_auto_lock_never" />
                    </LinearLayout>

                    <ImageView style="@style/Remote.Chevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Log out all sessions -->
                <LinearLayout
                    android:id="@+id/remote_auth_logout_all_row"
                    style="@style/Remote.Row"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Remote.RowTitle"
                            android:text="@string/remote_security_logout_all" />

                        <TextView
                            style="@style/Remote.RowValue"
                            android:text="@string/remote_security_logout_all_desc" />
                    </LinearLayout>

                    <ImageView style="@style/Remote.Chevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══ HELP ══ -->
            <TextView
                android:id="@+id/remote_section_help_label"
                style="@style/Remote.Section"
                android:text="@string/remote_section_help" />

            <LinearLayout
                style="@style/Remote.Card"
                android:padding="14dp">

                <TextView
                    style="@style/Remote.RowTitle"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/stream_instructions" />

                <TextView
                    style="@style/Remote.HelpStep"
                    android:text="@string/stream_instr_1" />

                <TextView
                    style="@style/Remote.HelpStep"
                    android:text="@string/stream_instr_2" />

                <TextView
                    style="@style/Remote.HelpStep"
                    android:text="@string/stream_instr_3" />

                <TextView
                    style="@style/Remote.HelpStep"
                    android:layout_marginBottom="0dp"
                    android:text="@string/stream_instr_4" />
            </LinearLayout>

            <LinearLayout
                style="@style/Remote.Card"
                android:layout_marginTop="8dp"
                android:padding="14dp">

                <TextView
                    style="@style/Remote.RowTitle"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/stream_notes_title" />

                <TextView
                    style="@style/Remote.Note"
                    android:text="@string/stream_notes_wifi" />

                <TextView
                    style="@style/Remote.Note"
                    android:text="@string/stream_notes_quality" />

                <TextView
                    style="@style/Remote.Note"
                    android:text="@string/stream_notes_resolution" />

                <!-- The two warnings: amber and cyan tints, never alarm colours -->
                <TextView
                    style="@style/Remote.Note"
                    android:textColor="@color/s_careful"
                    android:text="@string/stream_notes_cellular" />

                <TextView
                    style="@style/Remote.Note"
                    android:layout_marginBottom="0dp"
                    android:textColor="@color/s_armed"
                    android:text="@string/stream_notes_android14_screen" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
