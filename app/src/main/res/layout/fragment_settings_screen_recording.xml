<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Fixed Header -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@drawable/header_bar_rounded_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="2dp"
            android:src="@drawable/ic_close"
            android:tint="@color/s_ink_dim"/>
        <TextView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_recording_title"
            android:fontFamily="@font/joy_display"
            android:textSize="19sp"
            android:textColor="@color/s_ink"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingBottom="76dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/header_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp">

            <!-- Group Card -->
            <LinearLayout
                android:id="@+id/group_quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_group_card_bg"
                android:padding="0dp">

                <!-- Resolution Row -->
                <LinearLayout
                    android:id="@+id/row_resolution"
                    style="@style/SettingsGroupRow">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_grid"
                        android:tint="@color/s_ink_faint"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/screen_rec_resolution"
                        android:fontFamily="@font/joy_body"
                        android:textSize="14sp"
                        android:textColor="?attr/colorHeading"/>
                    <TextView
                        android:id="@+id/value_resolution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_rec_resolution_value"
                        android:textColor="@color/s_ink_dim"
                        android:textSize="13sp"/>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/s_ink_faint"/>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Frame Rate Row -->
                <LinearLayout
                    android:id="@+id/row_framerate"
                    style="@style/SettingsGroupRow">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_fps"
                        android:tint="@color/s_ink_faint"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/screen_rec_framerate"
                        android:fontFamily="@font/joy_body"
                        android:textSize="14sp"
                        android:textColor="?attr/colorHeading"/>
                    <TextView
                        android:id="@+id/value_framerate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_rec_framerate_value"
                        android:textColor="@color/s_ink_dim"
                        android:textSize="13sp"/>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/s_ink_faint"/>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Bitrate Row -->
                <LinearLayout
                    android:id="@+id/row_bitrate"
                    style="@style/SettingsGroupRow">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_bitrate"
                        android:tint="@color/s_ink_faint"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/screen_rec_bitrate"
                        android:fontFamily="@font/joy_body"
                        android:textSize="14sp"
                        android:textColor="?attr/colorHeading"/>
                    <TextView
                        android:id="@+id/value_bitrate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_rec_bitrate_value"
                        android:textColor="@color/s_ink_dim"
                        android:textSize="13sp"/>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/s_ink_faint"/>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Orientation Row -->
                <LinearLayout
                    android:id="@+id/row_orientation"
                    style="@style/SettingsGroupRow">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_screen_rotation"
                        android:tint="@color/s_ink_faint"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/screen_rec_orientation"
                        android:fontFamily="@font/joy_body"
                        android:textSize="14sp"
                        android:textColor="?attr/colorHeading"/>
                    <TextView
                        android:id="@+id/value_orientation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_portrait"
                        android:textColor="@color/s_ink_dim"
                        android:textSize="13sp"/>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/s_ink_faint"/>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Audio Source Row -->
                <LinearLayout
                    android:id="@+id/row_audio_source"
                    style="@style/SettingsGroupRow">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_audio"
                        android:tint="@color/s_ink_faint"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/fadrec_audio_source_title"
                        android:fontFamily="@font/joy_body"
                        android:textSize="14sp"
                        android:textColor="?attr/colorHeading"/>
                    <TextView
                        android:id="@+id/value_audio_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_microphone"
                        android:textColor="@color/s_ink_dim"
                        android:textSize="13sp"/>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/s_ink_faint"/>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Video Splitting Row (shared with FadCam) -->
                <LinearLayout
                    android:id="@+id/row_video_splitting"
                    style="@style/SettingsGroupRow">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_split_file"
                        android:tint="@color/s_ink_faint"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/video_splitting_title"
                            android:textColor="?attr/colorHeading"
                            android:fontFamily="@font/joy_body"
                            android:textSize="14sp"/>
                        <TextView
                            android:id="@+id/value_splitting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_off"
                            android:textColor="@color/s_ink_dim"
                            android:textSize="13sp"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/s_ink_faint"/>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Dual-stream: also record the raw webcam as its own synced file.
                     Row + divider are GONE unless the device supports two concurrent
                     hardware encoders (DualEncoderCapabilityChecker). Hardcoded text:
                     TODO(strings). -->
                <LinearLayout
                    android:id="@+id/row_dual_stream"
                    android:visibility="gone"
                    style="@style/SettingsGroupRow">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_camera"
                        android:tint="@color/s_ink_faint"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Record webcam as separate file"
                            android:textColor="?attr/colorHeading"
                            android:fontFamily="@font/joy_body"
                            android:textSize="14sp"/>
                        <TextView
                            android:id="@+id/value_dual_stream"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_off"
                            android:textColor="@color/s_ink_dim"
                            android:textSize="13sp"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/s_ink_faint"/>
                </LinearLayout>

                <View
                    android:id="@+id/divider_dual_stream"
                    android:visibility="gone"
                    style="@style/SettingsDivider" />

                <!-- Auto-pause recording while floating menu is open -->
                <LinearLayout
                    android:id="@+id/row_menu_auto_pause"
                    style="@style/SettingsGroupRow">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_pause"
                        android:tint="@color/s_ink_faint"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_auto_pause_title"
                            android:textColor="?attr/colorHeading"
                            android:fontFamily="@font/joy_body"
                            android:textSize="14sp"/>
                        <TextView
                            android:id="@+id/value_menu_auto_pause"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_on"
                            android:textColor="@color/s_ink_dim"
                            android:textSize="13sp"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/s_ink_faint"/>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- Floating button recording-state tint -->
                <LinearLayout
                    android:id="@+id/row_button_state_tint"
                    style="@style/SettingsGroupRow">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/color_picker_swatch_circle"
                        android:tint="@color/s_ink_faint"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/button_state_tint_title"
                            android:textColor="?attr/colorHeading"
                            android:fontFamily="@font/joy_body"
                            android:textSize="14sp"/>
                        <TextView
                            android:id="@+id/value_button_state_tint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_on"
                            android:textColor="@color/s_ink_dim"
                            android:textSize="13sp"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/s_ink_faint"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
