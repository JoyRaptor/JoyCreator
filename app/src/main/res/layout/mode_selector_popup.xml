<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mode_popup_root"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/s_panel"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/s_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- All -->
        <LinearLayout
            android:id="@+id/mode_all"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/legacyv2_popup_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/materialicons"
                android:importantForAccessibility="no"
                android:text="apps"
                android:textColor="@color/s_ink_dim"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/label_all"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="@string/settings_tab_all"
                android:textColor="@color/s_ink"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/check_all"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:fontFamily="@font/materialicons"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="check"
                android:textColor="@color/s_on_go"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Joy Creator (camera) -->
        <LinearLayout
            android:id="@+id/mode_fadcam"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/legacyv2_popup_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/materialicons"
                android:importantForAccessibility="no"
                android:text="videocam"
                android:textColor="@color/s_ink_dim"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/label_fadcam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="@string/settings_tab_fadcam"
                android:textColor="@color/s_ink"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/check_fadcam"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:fontFamily="@font/materialicons"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="check"
                android:textColor="@color/s_on_go"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Screen recording -->
        <LinearLayout
            android:id="@+id/mode_fadrec"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/legacyv2_popup_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"
                android:scaleType="centerInside"
                android:src="@drawable/screen_recorder"
                app:tint="@color/s_ink_dim" />
            <TextView
                android:id="@+id/label_fadrec"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="@string/settings_tab_fadrec"
                android:textColor="@color/s_ink"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/check_fadrec"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:fontFamily="@font/materialicons"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="check"
                android:textColor="@color/s_on_go"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
