<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:layoutDirection="ltr"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Centred rather than pushed down 120dp from the top.
             A fixed top margin decides where the content STARTS and says nothing about
             where it ends, so on this phone the three promises, the key card and LET ME IN
             all finished by 68% of the screen and the last third was empty. Centring makes
             the leftover space split evenly above and below, which is what the eye reads as
             a composed page rather than as a page that ran out. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layoutDirection="ltr"
            android:layout_centerVertical="true"
            android:paddingTop="@dimen/onboarding_nav_margin"
            android:paddingBottom="@dimen/onboarding_nav_margin">

            <TextView
            android:id="@+id/lottieHuman"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/materialicons"
            android:text="handshake"
            android:textSize="46sp"
            android:textColor="#FF35F6BF"
            android:includeFontPadding="false"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvHumanTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_human_title"
                android:textSize="@dimen/onboarding_title_size"
                android:textStyle="bold"
                android:fontFamily="@font/joy_display"
                android:textColor="#FFE4E4E7"
                android:gravity="center"
                android:layout_marginLeft="@dimen/onboarding_margin"
                android:layout_marginRight="@dimen/onboarding_margin"
            android:textFontWeight="900" />

            <TextView
                android:id="@+id/tvHumanDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_human_desc"
                android:textSize="@dimen/onboarding_desc_size"
                android:fontFamily="@font/joy_body"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_marginTop="@dimen/onboarding_margin"
                android:layout_marginLeft="@dimen/onboarding_margin"
                android:layout_marginRight="@dimen/onboarding_margin" />

            <!-- Custom Checkbox Row 1 -->
            <LinearLayout
                android:id="@+id/checkbox_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/onboarding_margin"
                android:layout_marginLeft="@dimen/onboarding_margin"
                android:layout_marginRight="@dimen/onboarding_margin"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/checkbox_icon_1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/placeholder_checkbox_outline"
                    android:contentDescription="@string/onboarding_human_checkbox1"
                    android:layout_marginRight="12dp"
                    android:padding="2dp"
                    android:tint="@color/white" />

                <TextView
                    android:id="@+id/checkbox_label_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/onboarding_human_checkbox1"
                    android:textColor="@color/white"
                    android:fontFamily="@font/joy_body"
                    android:textSize="@dimen/onboarding_desc_size" />
            </LinearLayout>

            <!-- Custom Checkbox Row 2 -->
            <LinearLayout
                android:id="@+id/checkbox_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:layout_marginLeft="@dimen/onboarding_margin"
                android:layout_marginRight="@dimen/onboarding_margin"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/checkbox_icon_2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/placeholder_checkbox_outline"
                    android:contentDescription="@string/onboarding_human_checkbox2"
                    android:layout_marginRight="12dp"
                    android:padding="2dp"
                    android:tint="@color/white" />

                <TextView
                    android:id="@+id/checkbox_label_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/onboarding_human_checkbox2"
                    android:textColor="@color/white"
                    android:fontFamily="@font/joy_body"
                    android:textSize="@dimen/onboarding_desc_size" />
            </LinearLayout>

            <!-- Custom Checkbox Row 3 - Privacy Policy -->
            <LinearLayout
                android:id="@+id/checkbox_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:layout_marginLeft="@dimen/onboarding_margin"
                android:layout_marginRight="@dimen/onboarding_margin"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/checkbox_icon_3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/placeholder_checkbox_outline"
                    android:contentDescription="@string/onboarding_human_checkbox3"
                    android:layout_marginRight="12dp"
                    android:padding="2dp"
                    android:tint="@color/white" />

                <TextView
                    android:id="@+id/checkbox_label_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/onboarding_human_checkbox3"
                    android:textColor="@color/white"
                    android:fontFamily="@font/joy_body"
                    android:textSize="@dimen/onboarding_desc_size"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

                            <!-- ── THE KEY, OFFERED ONCE, WHERE IT MAKES SENSE ─────────────────
                     JoyRaptor, 2026-09-17: "mentioning the ai server provider on the
                     third screen is a perfect time to say 'have one already? You can
                     add its api now if you like'."

                     It sits under the privacy line because that is the sentence that
                     earns the right to ask. Declining costs nothing and SAYS WHERE TO
                     FIND IT AGAIN, which is the half that stops people worrying they
                     have missed something.
                     ──────────────────────────────────────────────────────────────── -->
                <LinearLayout
                    android:id="@+id/intro_ai_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/intro_ai_card_bg"
                    android:padding="14dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="6dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/intro_ai_note"
                        android:textColor="#FFA1A1AA"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/intro_ai_have_key"
                        android:textColor="#FFE4E4E7"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="9dp">

                        <TextView
                            android:id="@+id/intro_ai_add"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="@string/intro_ai_add_now"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/joybot_orb_pill" />

                        <TextView
                            android:id="@+id/intro_ai_later"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:layout_marginStart="8dp"
                            android:text="@string/intro_ai_later"
                            android:textColor="#FFA1A1AA"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

<com.google.android.material.button.MaterialButton
                android:id="@+id/btn_human_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_human_button"
                android:fontFamily="@font/joy_display"
                android:textSize="@dimen/onboarding_button_text_size"
                android:textColor="#FF050507"
                android:background="@drawable/studio_action_pill"
                app:cornerRadius="0dp"
                app:strokeWidth="0dp"
                app:rippleColor="#33050507"
                android:layout_marginTop="@dimen/onboarding_margin"
                android:layout_marginLeft="@dimen/onboarding_nav_margin"
                android:layout_marginRight="@dimen/onboarding_nav_margin"
            android:textStyle="bold"
            android:textFontWeight="700"
            app:backgroundTint="@null" />
        </LinearLayout>
    </RelativeLayout>
</ScrollView> 