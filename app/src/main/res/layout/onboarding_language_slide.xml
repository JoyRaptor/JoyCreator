<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:background="@color/black"
    android:clipChildren="false"
    android:clipToPadding="false"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/languageSelectContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.35">

        <TextView
            android:id="@+id/lottieLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/materialicons"
            android:text="translate"
            android:textSize="46sp"
            android:textColor="#FF35F6BF"
            android:includeFontPadding="false"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp" 
            app:layout_constraintVertical_bias="0.30"/>

        <TextView
            android:id="@+id/languageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_language_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFE4E4E7"
            android:fontFamily="@font/joy_display"
            android:layout_marginBottom="10dp"
            android:textFontWeight="900" />

        <TextView
            android:id="@+id/languageNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_select_language"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:fontFamily="@font/joy_body"
            android:layout_marginBottom="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/language_choose_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_language"
            style="@style/Widget.MaterialComponents.Button"
            app:icon="@drawable/ic_language"
            app:iconPadding="8dp"
            app:iconGravity="textStart"
            android:fontFamily="@font/joy_display"
            android:textSize="16sp"
            android:layout_marginBottom="18dp"
            android:textColor="#FFA1A1AA"
            android:textStyle="bold"
            android:textFontWeight="700"
            app:backgroundTint="@null"
            android:background="@drawable/intro_ghost_pill"
            app:cornerRadius="0dp"
            app:strokeWidth="0dp" />

        <TextView
            android:id="@+id/languageChangeLaterNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/language_change_later_note"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:fontFamily="@font/joy_body"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView> 