<?xml version="1.0" encoding="utf-8"?>
<!-- First-run intro, page 2. Same bones as the "Before we start" page: old-black ground,
     centred stack, zinc panels, one gradient primary. Colour only guides: cyan = allowed. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/s_ground"
    android:layoutDirection="ltr"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:paddingTop="@dimen/onboarding_nav_margin"
            android:paddingBottom="@dimen/onboarding_nav_margin">

            <TextView
                android:id="@+id/lottiePermissions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/materialicons"
                android:text="verified_user"
                android:textSize="46sp"
                android:textColor="@color/s_go"
                android:includeFontPadding="false"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/permissionsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboardingv2_perm_title"
                android:textSize="@dimen/onboarding_title_size"
                android:textColor="@color/s_ink"
                android:gravity="center"
                android:layout_marginLeft="@dimen/onboarding_margin"
                android:layout_marginRight="@dimen/onboarding_margin" />

            <TextView
                android:id="@+id/permissionsDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboardingv2_perm_why"
                android:textSize="@dimen/onboarding_desc_size"
                android:textColor="@color/s_ink_dim"
                android:gravity="center"
                android:layout_marginTop="@dimen/onboarding_margin"
                android:layout_marginLeft="@dimen/onboarding_margin"
                android:layout_marginRight="@dimen/onboarding_margin" />

            <LinearLayout
                android:id="@+id/permissionsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp">

            <LinearLayout
                android:id="@+id/row_camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/intro_ai_card_bg"
                android:padding="14dp"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="@dimen/onboarding_margin"
                android:layout_marginRight="@dimen/onboarding_margin">

                <TextView
                    android:id="@+id/glyph_camera"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:fontFamily="@font/materialicons"
                    android:text="photo_camera"
                    android:textSize="24sp"
                    android:textColor="@color/s_ink_dim"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="12dp">

                    <TextView
                        android:id="@+id/title_camera"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboardingv2_perm_camera"
                        android:textSize="16sp"
                        android:textColor="@color/s_ink" />

                    <TextView
                        android:id="@+id/why_camera"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboardingv2_perm_camera_why"
                        android:textSize="13sp"
                        android:textColor="@color/s_ink_dim"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mark_camera"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:background="@drawable/perm_mark_off"
                    android:fontFamily="@font/materialicons"
                    android:text="check"
                    android:textSize="18sp"
                    android:textColor="@color/s_ground"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_mic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/intro_ai_card_bg"
                android:padding="14dp"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="@dimen/onboarding_margin"
                android:layout_marginRight="@dimen/onboarding_margin">

                <TextView
                    android:id="@+id/glyph_mic"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:fontFamily="@font/materialicons"
                    android:text="mic"
                    android:textSize="24sp"
                    android:textColor="@color/s_ink_dim"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="12dp">

                    <TextView
                        android:id="@+id/title_mic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboardingv2_perm_mic"
                        android:textSize="16sp"
                        android:textColor="@color/s_ink" />

                    <TextView
                        android:id="@+id/why_mic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboardingv2_perm_mic_why"
                        android:textSize="13sp"
                        android:textColor="@color/s_ink_dim"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mark_mic"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:background="@drawable/perm_mark_off"
                    android:fontFamily="@font/materialicons"
                    android:text="check"
                    android:textSize="18sp"
                    android:textColor="@color/s_ground"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/intro_ai_card_bg"
                android:padding="14dp"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="@dimen/onboarding_margin"
                android:layout_marginRight="@dimen/onboarding_margin">

                <TextView
                    android:id="@+id/glyph_files"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:fontFamily="@font/materialicons"
                    android:text="folder"
                    android:textSize="24sp"
                    android:textColor="@color/s_ink_dim"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="12dp">

                    <TextView
                        android:id="@+id/title_files"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboardingv2_perm_files"
                        android:textSize="16sp"
                        android:textColor="@color/s_ink" />

                    <TextView
                        android:id="@+id/why_files"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboardingv2_perm_files_why"
                        android:textSize="13sp"
                        android:textColor="@color/s_ink_dim"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mark_files"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:background="@drawable/perm_mark_off"
                    android:fontFamily="@font/materialicons"
                    android:text="check"
                    android:textSize="18sp"
                    android:textColor="@color/s_ground"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/intro_ai_card_bg"
                android:padding="14dp"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="@dimen/onboarding_margin"
                android:layout_marginRight="@dimen/onboarding_margin"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/onboardingv2_perm_battery_cd">

                <TextView
                    android:id="@+id/glyph_battery"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:fontFamily="@font/materialicons"
                    android:text="battery_charging_full"
                    android:textSize="24sp"
                    android:textColor="@color/s_ink_dim"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="12dp">

                    <TextView
                        android:id="@+id/title_battery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboardingv2_perm_battery"
                        android:textSize="16sp"
                        android:textColor="@color/s_ink" />

                    <TextView
                        android:id="@+id/why_battery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboardingv2_perm_battery_why"
                        android:textSize="13sp"
                        android:textColor="@color/s_ink_dim"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mark_battery"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:background="@drawable/perm_mark_off"
                    android:fontFamily="@font/materialicons"
                    android:text="check"
                    android:textSize="18sp"
                    android:textColor="@color/s_ground"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/permission_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="@color/s_careful"
                android:visibility="gone"
                android:layout_marginTop="12dp"
                android:layout_marginLeft="@dimen/onboarding_margin"
                android:layout_marginRight="@dimen/onboarding_margin" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/permissions_grant_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboardingv2_perm_allow"
                android:contentDescription="@string/onboardingv2_perm_allow_cd"
                android:textSize="@dimen/onboarding_button_text_size"
                android:textColor="@color/s_on_go"
                android:background="@drawable/studio_action_pill"
                app:cornerRadius="0dp"
                app:strokeWidth="0dp"
                app:backgroundTint="@null"
                android:layout_marginTop="@dimen/onboarding_margin"
                android:layout_marginLeft="@dimen/onboarding_nav_margin"
                android:layout_marginRight="@dimen/onboarding_nav_margin" />

            <TextView
                android:id="@+id/open_settings_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_gravity="center_horizontal"
                android:text="@string/onboardingv2_perm_open_settings"
                android:contentDescription="@string/onboardingv2_perm_open_settings_cd"
                android:textSize="14sp"
                android:textColor="@color/s_ink_dim"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
