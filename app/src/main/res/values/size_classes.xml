<?xml version="1.0" encoding="utf-8"?>
<!-- TAB-1 window sizes. Wide-window resources go in values-w600dp (medium) and values-w840dp
     (expanded), never sw600dp: see com.fadcam.ui.size.SizeClass. -->
<resources>
    <!-- ContentColumn keeps its bookkeeping on the view under this tag. -->
    <item name="content_column_state" type="id"/>
    <!-- Bottom sheets stop at this width on a wide window (Material 3's own figure). -->
    <dimen name="sheet_max_width">640dp</dimen>
</resources>
