    <string name="faditor_lc_fx_bypass">Bypass effect</string>
    <string name="faditor_lc_fx_enable">Enable effect</string>
    <string name="faditor_lc_fx_delete">Delete effect</string>
    <string name="faditor_lc_fx_reorder">Hold and drag to reorder</string>

