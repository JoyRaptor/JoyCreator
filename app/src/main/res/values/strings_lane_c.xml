<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings for the in-editor drawers: effects (FxPanel), the text drawer shell, the ease and
  text-motion pickers, and the object menu sheet. Kept in their own file so the drawer polish
  could land without touching strings.xml; safe to fold into it later, names unchanged.

  Most of these are accessibility labels. They are also the hover tooltips a stylus or mouse
  shows, so they are written as what the control DOES, in the owner's words where he has any.
-->
<resources>
    <!-- Text drawer shell -->
    <string name="faditor_lc_drawer_more">More ⌄</string>
    <string name="faditor_lc_drawer_grip">Drawer handle. Drag to resize, tap to show more or close</string>

    <!-- Effects panel -->
