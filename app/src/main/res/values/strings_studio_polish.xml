<?xml version="1.0" encoding="utf-8"?>
<!-- Strings added by the STUDIO_POLISH lane. Kept out of strings.xml on purpose: that file
     carries other lanes' staged, uncommitted work, and sharing it is how merges go wrong.
     The font picker's title, import row and "selected" label already exist in strings.xml
     (faditor_font_picker_title / _import / _row_selected) and are reused, not redefined. -->
<resources>
    <!-- The caption drawer's single font button. %1$s is the current font's name. -->
    <string name="faditor_font_button_desc">Font: %1$s. Tap to choose another.</string>
    <!-- The drawer's Frost / Solid switch. JoyRaptor: "Frosted drawers need a SOLID toggle ...
         annoying for someone doing precise work with the drawer looking at the composition
         behind it." Shown as the record's small mono lens labels. -->
    <string name="drawer_lens_frost">FROST</string>
    <string name="drawer_lens_solid">SOLID</string>
    <string name="drawer_lens_frost_desc">See-through drawer, so the video shows behind it</string>
    <string name="drawer_lens_solid_desc">Solid drawer, for precise work</string>
    <!-- All tools sheet sections, record 06 .tg. "Recently used" stands in for the record's
         "Most used by you": the app keeps WHEN a tool was used, not how often. -->
    <string name="tools_group_recent">Recently used</string>
    <string name="tools_group_act">Act on what\'s selected</string>
    <string name="tools_group_add">Add something</string>
    <string name="tools_group_sound">Sound &amp; words</string>
    <string name="tools_group_project">The project &amp; the workspace</string>
    <!-- Image drawer, Move tab -->
    <string name="image_move_new_lane">New lane</string>
    <string name="image_move_above">Above</string>
    <string name="image_move_above_desc">Put this on a new lane above the others</string>
    <string name="image_move_below">Below</string>
    <string name="image_move_below_desc">Put this on a new lane below the others</string>
    <string name="image_move_label">Move</string>
    <string name="image_move_up">Up a lane ▲</string>
    <string name="image_move_up_desc">Move this up one lane</string>
    <string name="image_move_down">Down a lane ▼</string>
    <string name="image_move_down_desc">Move this down one lane</string>
</resources>
