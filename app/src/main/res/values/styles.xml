<resources>
    <style name="CustomBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="background">@drawable/picker_bottom_sheet_gradient_bg_dynamic</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="CustomSideSheetStyle" parent="Widget.Material3.SideSheet.Modal">
        <item name="backgroundTint">@null</item>
    </style>

    <style name="CustomSideSheetDialogTheme" parent="ThemeOverlay.Material3.SideSheetDialog">
        <item name="sideSheetModalStyle">@style/CustomSideSheetStyle</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Widget.FadCam.BottomSheetSlider" parent="Widget.Material3.Slider">
        <item name="trackColorActive">?attr/pickerSliderActive</item>
        <item name="trackColorInactive">?attr/pickerSliderInactive</item>
        <item name="tickColorActive">?attr/pickerSliderActive</item>
        <item name="tickColorInactive">?attr/pickerSliderInactive</item>
        <item name="tickVisible">false</item>
        <item name="thumbColor">?attr/pickerSliderActive</item>
        <item name="haloColor">?attr/pickerSliderActive</item>
        <item name="trackHeight">4dp</item>
        <item name="thumbRadius">10dp</item>
        <item name="haloRadius">18dp</item>
    </style>

    <style name="Widget.FadCam.RecordsFilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinHeight">28dp</item>
        <item name="android:minHeight">28dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:textSize">11sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipStrokeColor">@android:color/transparent</item>
        <item name="chipCornerRadius">8dp</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="textStartPadding">4dp</item>
        <item name="textEndPadding">4dp</item>
        <item name="iconStartPadding">2dp</item>
        <item name="iconEndPadding">2dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="chipBackgroundColor">@color/chip_floating_bg_color</item>
        <item name="chipSurfaceColor">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="RecordsActionPill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/settings_group_card_bg</item>
        <item name="android:textColor">?attr/pickerTextPrimary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="KoFiButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/kofi_button_bg</item>
        <item name="android:textColor">#222222</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <!-- Fix Start: Add missing Material text appearance styles for compatibility -->
    <style name="textAppearanceSubtitle1" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorHeading</item>
    </style>
    <style name="textAppearanceCaption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="textAppearanceSubtitle2" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorHeading</item>
    </style>
    <!-- Fix End: Add missing Material text appearance styles for compatibility -->

    <!-- Settings home row style -->
    <style name="SettingsGroupRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:background">@drawable/settings_home_row_bg</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="SettingsDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#262626</item>
        <!-- Match SettingsGroupRow horizontal insets (14dp start / 12dp end) -->
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">12dp</item>
    </style>

    <!-- TextAppearances for AppWidget (Ubuntu font) -->
    <style name="WidgetText.Ubuntu.Regular" parent="">
        <item name="android:fontFamily">@font/ubuntu_regular</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="WidgetText.Ubuntu.Bold" parent="WidgetText.Ubuntu.Regular">
        <item name="android:textStyle">bold</item>
    </style>

    <!--
      The in-canvas text editor's caret and SELECTION HANDLES.

      The editor itself is transparent ink laid over the glyphs TextBoxRenderer draws, so the
      only native chrome the user ever sees from it is the caret and the two drag handles. Those
      take their colour from colorControlActivated, which on the editor's default context is the
      platform teal — invisible against half the footage anyone puts behind it.

      Applied by wrapping the editor's Context (see TextOverlayLayer.startTextEditing) rather
      than by calling setTextSelectHandle/setTextCursorDrawable, which are API 29 and would need
      a version branch and three drawables to say the same thing. The handles stay the PLATFORM's
      teardrops on purpose: drag-to-extend, word snapping and accessibility come with them, and
      users already know how to grab them.
    -->
    <style name="FaditorTextEditorTheme" parent="Theme.AppCompat">
        <item name="colorControlActivated">@color/faditor_text_selection_accent</item>
        <item name="colorAccent">@color/faditor_text_selection_accent</item>
    </style>

    <!-- Switch theme for floating menu -->
    <style name="SwitchTheme" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated">#4CAF50</item>
        <item name="colorSwitchThumbNormal">#FFFFFF</item>
        <item name="android:colorForeground">#FFFFFF</item>
    </style>

    <!-- Transparent editor activity theme -->
    <style name="TransparentEditorTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- FadCam Pro Activity Theme with Ubuntu Font -->
    <style name="FadCamProTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/ubuntu_regular</item>
    </style>

    <!-- ══ THE STUDIO THEME ═══════════════════════════════════════════════════
         Every value here now comes from @color/s_* in studio_tokens.xml.

         This style is the single highest-leverage thing in the editor, and it was
         the root cause of the complaint "the greens should all be replaced with
         the studio green gradient". colorPrimary was Material green, and Material
         resolves it for EVERY slider, switch, checkbox, ripple, text cursor and
         selection handle — plus the 112 MaterialAlertDialogs the editor builds.
         None of those had a line of colour code to grep for; they were green
         because the theme said so. Changing this one line changes all of them.
         ═══════════════════════════════════════════════════════════════════════ -->
    <style name="Theme.FadCam.FaditorEditor" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorSurface">@color/s_panel</item>
        <item name="colorSurfaceVariant">@color/s_raised</item>
        <item name="colorOnSurface">@color/s_ink</item>
        <item name="colorOnSurfaceVariant">@color/s_ink_dim</item>
        <item name="colorPrimary">@color/s_go</item>
        <!-- Ink ON the primary. The aqua is LIGHT, so black text on it measures
             about 12:1 where the old white-on-Material-green managed 2.8:1. -->
        <item name="colorOnPrimary">@color/s_on_go</item>
        <item name="colorSecondaryContainer">@color/s_raised</item>
        <item name="android:windowBackground">@color/s_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/s_surface</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Required for picker_bottom_sheet and InputActionBottomSheetFragment -->
        <item name="pickerTextSecondary">@color/s_ink_faint</item>
        <item name="pickerTextPrimary">@color/s_ink</item>
        <!-- A heading is STRUCTURE. Colour spent on structure cannot be spent on
             the thing you want pressed, so headings take ink and the gradient is
             kept for the one action per sheet that matters. -->
        <item name="colorHeading">@color/s_ink</item>
        <item name="pickerGradientStart">@color/s_ground</item>
        <item name="pickerGradientMid">@color/s_panel</item>
        <item name="pickerGradientEnd">@color/s_raised</item>
    </style>

    <style name="Theme.FadCam.ChatAssistant" parent="Theme.FadCam.FaditorEditor">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- Dark delete confirmation dialog with red action buttons.
         Extends AppCompat dark dialog to always show dark background regardless of device theme. -->
    <style name="WatchDeleteConfirmDialog" parent="Theme.AppCompat.Dialog.Alert">
        <!-- Panel / window background — force dark -->
        <item name="android:background">#1A1A1A</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- Text colors to white -->
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
        <!-- Button text color via accent -->
        <item name="colorAccent">#CC2222</item>
    </style>

</resources>
