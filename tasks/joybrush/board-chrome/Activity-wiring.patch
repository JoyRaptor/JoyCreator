 class JoyBrushActivity : Activity() {

+    internal data class BoardChromeScene(
+        val id: String,
+        val input: BoardChromeLayout.Input,
+        val host: BoardChromeView.Host,
+        val ink: IconInk,
+        val paperColour: Int
+    )
+    internal interface BoardChromeBinding {
+        fun scenes(): List<BoardChromeScene>
+        fun rawPen(event: MotionEvent)
+        fun viewMoved()
+        fun strokeEnded()
+        fun pause()
+    }
+    private lateinit var boardChromeLayer: FrameLayout
+    private val boardChromeViews = LinkedHashMap<String, BoardChromeView>()
+    private var boardChromeBinding: BoardChromeBinding? = null
+
+    internal fun bindBoardChrome(binding: BoardChromeBinding?) {
+        boardChromeViews.values.forEach { it.stopInteractions() }
+        boardChromeBinding?.pause()
+        boardChromeBinding = binding
+        refreshBoardChrome()
+    }
+
+    internal fun refreshBoardChrome() {
+        if (!::boardChromeLayer.isInitialized) return
+        val scenes = boardChromeBinding?.scenes().orEmpty()
+        val ids = scenes.map { it.id }.toSet()
+        require(ids.size == scenes.size) { "Duplicate board chrome scene ID" }
+        boardChromeViews.keys.filter { it !in ids }.toList().forEach { id ->
+            val view = boardChromeViews.remove(id)!!
+            view.stopInteractions()
+            boardChromeLayer.removeView(view)
+        }
+        for (scene in scenes) {
+            val view = boardChromeViews.getOrPut(scene.id) {
+                BoardChromeView(this).also {
+                    boardChromeLayer.addView(it, FrameLayout.LayoutParams(MATCH, MATCH))
+                }
+            }
+            view.host = scene.host
+            view.paperInk = scene.ink
+            view.paperColour = scene.paperColour
+            view.show(scene.input)
+        }
+    }
+
