#!/usr/bin/env bash
# Cloud tests only (Linux runner): a few jvm-harness scripts call Windows' cygpath to turn a path into C:/ form.
# On Linux a path is already what java wants, so this prints it back unchanged (flags such as -m or -w ignored).
for a in "$@"; do
    case "$a" in -*) ;; *) printf '%s\n' "$a" ;; esac
done
