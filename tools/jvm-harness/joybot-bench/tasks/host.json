    "second": {"words": "make the draft note blue"},
    "reference": [
      {"calls": [{"name": "set_text_style", "args": {"text": "t-title", "color": "#FF0000"}}], "chunkDelayMs": 300},
      {"calls": [{"name": "set_text_style", "args": {"text": "t-draft", "color": "#0000FF"}}]},
      {"text": "The draft note is blue now."}
    ],
    "events": [{"when": "during", "request": 1, "chunk": 1, "do": "stopAndSend"}],
    "expect": {
      "require": [{"path": "timeline.textOverlays[t-draft].colorInt", "eq": "#0000FF"},
