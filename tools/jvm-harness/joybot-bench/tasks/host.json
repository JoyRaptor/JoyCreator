  {
    "id": "host-stop-then-send",
    "title": "J3: Stop request A after its first step, send B at once; A must never continue",
    "live": false,
    "words": "make the title red",
    "second": {"words": "make the draft note blue"},
    "reference": [
      {"calls": [{"name": "get_item", "args": {"id": "t-title"}}]},
      {"calls": [{"name": "set_text_style", "args": {"text": "t-draft", "color": "#0000FF"}}]},
      {"text": "The draft note is blue now."}
    ],
    "events": [{"when": "after", "request": 1, "do": "stopAndSend"}],
    "expect": {
      "require": [{"path": "timeline.textOverlays[t-draft].colorInt", "eq": "#0000FF"},
                  {"path": "timeline.textOverlays[t-title].colorInt", "eq": "#FFFFFFFF"}],
      "noLateRequests": true, "secondDone": true, "undoSteps": 1
    }
  },
  {
    "id": "host-stop-mid-reply",
    "title": "J3: Stop while A's reply (a title change) is still streaming, send B; A's change must not happen",
    "live": false,
